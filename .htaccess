# Hedef Elektrik — statik site (Alastyr / LiteSpeed)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8
AddType font/woff2 .woff2
AddType image/svg+xml .svg

<IfModule mod_rewrite.c>
RewriteEngine On

# Tek adres: https + www'suz
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://hedefelektrikuydu.com%{REQUEST_URI} [L,R=301]

# Eski WordPress'in index.php'si (dosyalar temizlenene kadar sunucuda durabilir) -> ana sayfa
RewriteRule ^index\.php$ / [L,R=301]

# /sayfa/index.html -> /sayfa/
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?]
RewriteRule ^(.*/)?index\.html$ /$1 [L,R=301]

# Eski WordPress adresleri -> yeni karşılıkları
RewriteRule ^(sitemap_index|page-sitemap|post-sitemap|category-sitemap)\.xml$ /sitemap.xml [L,R=301]
RewriteRule ^(comments/)?feed/?$ /blog/ [L,R=301]
RewriteRule ^blog/page/[0-9]+/?$ /blog/ [L,R=301]
RewriteRule ^category/([a-z0-9-]+)/page/[0-9]+/?$ /category/$1/ [L,R=301]
RewriteRule ^category/([a-z0-9-]+)/feed/?$ /category/$1/ [L,R=301]
RewriteRule ^([a-z0-9-]+)/feed/?$ /$1/ [L,R=301]
RewriteRule ^author/ / [L,R=301]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id|cat)=[0-9]+ [NC]
RewriteRule ^$ /? [L,R=301]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
<FilesMatch "\.(woff2)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(png|jpg|jpeg|svg|ico)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "\.(html|xml|txt)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript image/svg+xml
</IfModule>
